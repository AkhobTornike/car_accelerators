rules_version = '2';

// Nothing is readable or writable from a browser or app. Only the server (Admin SDK, which bypasses
// these rules) touches the data. Keep it that way: the shop's customers' personal data lives here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
