# Copy to .env.local (never commit it).
#
# Data backend: unset = JSON files in ./data (local development). "firestore" = Firebase Firestore.
# DATA_BACKEND=firestore
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# CATALOGUE_CACHE_SECONDS=600
# On a host without files (Vercel): paste the whole service-account JSON (or its base64) instead of the path:
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Admin API access. Admins sign in with Google (Firebase); only these verified emails get in (comma separated).
# ADMIN_EMAILS=amperagebattery@gmail.com
#
# Optional static bearer token (>= 24 characters) for curl/scripts/local dev. Leave it unset in production.
# ADMIN_API_TOKEN=

# Firebase web app config for the admin login screen. These values are PUBLIC identifiers (they ship to the browser),
# safe to commit. Project: amperage-90dfc, web app: amper-admin.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBtPcuakM32Q_9kBdp5Q6j1a_5_bkGf3L4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=amperage-90dfc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=amperage-90dfc
NEXT_PUBLIC_FIREBASE_APP_ID=1:350461290618:web:5658b0f35342185c6573c3

# Secret path segment of the admin screens: they live at /m/<ADMIN_PATH>/ and answer 404 for any other segment.
# Obscurity only; the real protection is the Google login. Use a long random string.
# ADMIN_PATH=
#
# Public base URL of the site — robots.txt and sitemap.xml point here. Default: http://localhost:3000
# SITE_URL=https://amper.ge
