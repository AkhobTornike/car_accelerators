# Copy to .env.local (never commit it).
#
# Data backend: unset = JSON files in ./data (local development). "firestore" = Firebase Firestore.
# DATA_BACKEND=firestore
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# CATALOGUE_CACHE_SECONDS=600
# On a host without files (Vercel): paste the whole service-account JSON (or its base64) instead of the path:
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Admin API access. Admins sign in with Google (Firebase); only these verified emails get in (comma separated).
# ADMIN_EMAILS=amperagebattery@gmail.com
#
# Optional static bearer token (>= 24 characters) for curl/scripts/local dev. Leave it unset in production.
# ADMIN_API_TOKEN=

# Firebase web app config for the admin login screen. These values are PUBLIC identifiers (they ship to the browser),
# safe to commit. Project: amperage-90dfc, web app: amper-admin.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBtPcuakM32Q_9kBdp5Q6j1a_5_bkGf3L4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=amperage-90dfc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=amperage-90dfc
NEXT_PUBLIC_FIREBASE_APP_ID=1:350461290618:web:5658b0f35342185c6573c3

# Secret path segment of the admin screens: they live at /m/<ADMIN_PATH>/ and answer 404 for any other segment.
# Obscurity only; the real protection is the Google login. Use a long random string.
# ADMIN_PATH=
#
# Public base URL of the site — robots.txt and sitemap.xml point here. Default: http://localhost:3000
# SITE_URL=https://ampera.ge
# If SITE_URL is unset, the Vercel production domain is used (VERCEL_PROJECT_PRODUCTION_URL); locally http://localhost:3000.
# Canonical links, hreflang, sitemap.xml, robots.txt, Open Graph and JSON-LD are all built from it.
#
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Analytics is OFF while this is empty. The site asks visitors for
# cookie consent first (Consent Mode v2: denied by default).
# NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification: only the content="..." value.
# NEXT_PUBLIC_GSC_VERIFICATION=

# Product images (Vercel Blob). Create a Blob store in the Vercel project; the token is added automatically.
BLOB_READ_WRITE_TOKEN=

# Receipt/invoice details (secret: tax id, IBAN). One JSON line; unset = fake demo data.
# SHOP_PROFILE_JSON={"brand":"","legalName":"","taxId":"","address":"","phone":"","vatPayer":false,"warrantyText":"","receiptPrefix":"R","paperDefault":"a4"}

# Weekly summary email (sent every Monday by the cron in vercel.json, and by the button in the admin Export tab).
# RESEND_API_KEY: secret key from resend.com; MAIL_FROM: an address on a domain verified there, e.g. "AMPER.GE <summary@ampera.ge>".
# SUMMARY_EMAIL_TO: comma separated recipients (default: the address in src/server/weekly-summary.ts).
# CRON_SECRET: any random string (>= 16 characters); Vercel sends it to the cron route, which refuses calls without it.
# ADMIN_PATH_ROTATE=weekly: the admin address then changes every ISO week (derived from ADMIN_PATH); the email carries it.
# RESEND_API_KEY=
# MAIL_FROM=
# SUMMARY_EMAIL_TO=
# CRON_SECRET=
# ADMIN_PATH_ROTATE=weekly
