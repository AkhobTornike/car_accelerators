# Copy to .env.local (never commit it).
#
# Data backend: unset = JSON files in ./data (local development). "firestore" = Firebase Firestore.
# DATA_BACKEND=firestore
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# CATALOGUE_CACHE_SECONDS=600
#
# Interim admin API guard (>= 24 characters). Replaced by Firebase login later.
# ADMIN_API_TOKEN=
