{
  "name": "amper-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "validate:data": "node --experimental-strip-types scripts/validate-data-cli.ts",
    "seed:firestore": "node --experimental-strip-types scripts/seed-firestore.ts",
    "test:emulators": "firebase emulators:exec --only firestore,auth --project demo-amper \"vitest run src/server/firestore src/server/admin-auth.emulator\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.32.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
