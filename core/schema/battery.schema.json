{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "battery.schema.json",
  "title": "Battery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "brand",
    "name",
    "segment",
    "tech",
    "voltage",
    "ah",
    "cca",
    "polarity",
    "caseCode",
    "dimsMm",
    "warrantyMonths",
    "price",
    "stock",
    "oemCodes",
    "active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "segment": {
      "enum": [
        "car",
        "truck",
        "moto",
        "deep"
      ]
    },
    "tech": {
      "enum": [
        "SMF",
        "EFB",
        "AGM",
        "DEEP-CYCLE"
      ]
    },
    "voltage": {
      "const": 12
    },
    "ah": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300
    },
    "cca": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2000
    },
    "polarity": {
      "enum": [
        "L+",
        "R+"
      ]
    },
    "caseCode": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "dimsMm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l",
        "w",
        "h"
      ],
      "properties": {
        "l": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "terminal": {
      "type": "string",
      "minLength": 1
    },
    "holdDown": {
      "type": "string",
      "minLength": 1
    },
    "warrantyMonths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "price": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "stock": {
      "enum": [
        "in",
        "order",
        "out"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "oemCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean"
    },
    "costPrice": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
